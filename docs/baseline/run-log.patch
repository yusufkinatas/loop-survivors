diff --git a/src/game/run-log.ts b/src/game/run-log.ts
new file mode 100644
index 0000000..2f7278e
--- /dev/null
+++ b/src/game/run-log.ts
@@ -0,0 +1,95 @@
+// The run recorder: what decisions a run actually contained, and when.
+//
+// A baseline that prototypes get A/B'd against cannot rest on memory — "the
+// build was full by about minute twenty" is not something you can hold a
+// redesign up against. This writes the run's decisions down as data: every
+// offer the run made, which one was taken, what the build was immediately
+// after, and the run second each of those happened at.
+//
+// It only ever receives. It never reads the world, never writes to it, and
+// nothing in the run branches on whether it is listening — so a recorded run
+// and an unrecorded one are the same run. Reading it back is a developer act,
+// done from the browser console via `loop.runLog`.
+
+import type { Role } from '../audio/kits';
+import type { ItemId } from './items';
+
+/** Which surface made an offer. The run has four, and they are not
+ *  interchangeable: the opening hire is not a level-up, and a chest's payout
+ *  is not a choice at all — every drop is yours, you just walk to them. */
+export type OfferSource = 'opening' | 'level-up' | 'evolution' | 'chest';
+
+/** A build at one instant: weapon levels, passive levels, evolved weapons. */
+export interface BuildSnapshot {
+  weapons: Array<[Role, number]>;
+  items: Array<[ItemId, number]>;
+  evolved: Role[];
+}
+
+type RunLogEntry =
+  | { kind: 'start'; t: number }
+  | { kind: 'offer'; t: number; level: number; source: OfferSource; options: string[] }
+  | { kind: 'take'; t: number; level: number; option: string; build: BuildSnapshot }
+  | { kind: 'chest'; t: number; level: number; size: number; evolution: boolean }
+  | { kind: 'levelUp'; t: number; level: number }
+  | { kind: 'end'; t: number; level: number; outcome: 'won' | 'died'; build: BuildSnapshot };
+
+function mmss(t: number): string {
+  const m = Math.floor(t / 60);
+  const s = Math.floor(t % 60);
+  return `${m}:${String(s).padStart(2, '0')}`;
+}
+
+function describeBuild(b: BuildSnapshot): string {
+  const weapons = b.weapons
+    .filter(([, level]) => level > 0)
+    .map(([role, level]) => `${role} ${level}${b.evolved.includes(role) ? '★' : ''}`);
+  const items = b.items.filter(([, level]) => level > 0).map(([id, level]) => `${id} ${level}`);
+  return `${weapons.join(', ') || '—'} | ${items.join(', ') || 'no passives'}`;
+}
+
+class RunLog {
+  private entries: RunLogEntry[] = [];
+
+  /** A new run wipes the last one: only the run you just played is interesting,
+   *  and an append-only log across runs would silently splice two of them. */
+  begin(): void {
+    this.entries = [{ kind: 'start', t: 0 }];
+  }
+
+  record(entry: RunLogEntry): void {
+    this.entries.push(entry);
+  }
+
+  get length(): number {
+    return this.entries.length;
+  }
+
+  json(): string {
+    return JSON.stringify(this.entries, null, 2);
+  }
+
+  /** The readable form: one line per decision, in run order, each carrying the
+   *  build it produced. Paste straight into the baseline doc. */
+  markdown(): string {
+    const lines: string[] = ['| time | lvl | what happened | build after |', '|---|---|---|---|'];
+    for (const e of this.entries) {
+      if (e.kind === 'start') continue;
+      if (e.kind === 'offer') {
+        lines.push(`| ${mmss(e.t)} | ${e.level} | **offered** (${e.source}): ${e.options.join(' / ')} | |`);
+      } else if (e.kind === 'take') {
+        lines.push(`| ${mmss(e.t)} | ${e.level} | **took** ${e.option} | ${describeBuild(e.build)} |`);
+      } else if (e.kind === 'chest') {
+        lines.push(`| ${mmss(e.t)} | ${e.level} | **chest** ×${e.size}${e.evolution ? ' (evolution)' : ''} | |`);
+      } else if (e.kind === 'levelUp') {
+        lines.push(`| ${mmss(e.t)} | ${e.level} | reached level ${e.level} | |`);
+      } else {
+        lines.push(`| ${mmss(e.t)} | ${e.level} | **run ${e.outcome}** | ${describeBuild(e.build)} |`);
+      }
+    }
+    return lines.join('\n');
+  }
+}
+
+/** The one recorder. A run has one decision history, so it has one home. */
+export const runLog = new RunLog();
