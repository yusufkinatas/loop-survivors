{
  "name": "loop-survivors",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "verify": "npm run check && node --import tsx src/game/tour-check.ts && node --import tsx src/game/systems-check.ts && node --import tsx src/game/weapon-parity-check.ts",
    "record:weapon-parity": "RECORD_WEAPON_PARITY=1 node --import tsx src/game/weapon-parity-check.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "pixi.js": "^8.6.0"
  }
}
